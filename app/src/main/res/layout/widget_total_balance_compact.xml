<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_total_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_total_balance_click_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_total_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available Balance"
            android:textColor="#FFB7ABB2"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_total_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="৳ 24,850.00"
            android:textColor="#FFF0E8EB"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_compact_add_income"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_btn_income"
        android:gravity="center"
        android:text="+"
        android:textColor="#FF83C9A0"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_compact_add_expense"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_btn_expense"
        android:gravity="center"
        android:text="−"
        android:textColor="#FFE59A9A"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
